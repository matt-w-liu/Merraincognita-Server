NODE_ENV=development
PORT=5000
# Comma-separated list of allowed CORS origins (no spaces required around commas)
CLIENT_URL=http://localhost:5173,https://merraincognita.com
MONGODB_URI=mongodb://127.0.0.1:27017/merraincognita
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
TRUST_PROXY=false
# Gmail / Google Workspace: use an App Password — normal account passwords are rejected (535 BadCredentials).
# 1) Enable 2-Step Verification on the Google account
# 2) https://myaccount.google.com/apppasswords → create "Mail" app password
# 3) Paste the 16-character password below (spaces optional). Do not use your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MERRAINCOGNITA LLC
SMTP_FROM_EMAIL=support@merraincognita.com
CONTACT_TO_EMAIL=support@merraincognita.com
PASSWORD_RESET_URL=http://localhost:5173/reset-password
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
CONTACT_RATE_LIMIT_MAX=5
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
